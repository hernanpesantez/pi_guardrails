{
  "name": "pi-agent-harness",
  "version": "0.1.0",
  "description": "Portable project rules, executable enforcement, and custom tools for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "rules",
    "enforcement"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-harness": "./bin/pi-harness.js"
  },
  "exports": {
    ".": "./src/engine.js"
  },
  "files": [
    "src",
    "extensions",
    "bin",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/harness.js"
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check extensions/harness.js && node --check src/engine.js && node --check src/manage.js && node --check bin/pi-harness.js",
    "prepack": "npm run check && npm test"
  }
}
